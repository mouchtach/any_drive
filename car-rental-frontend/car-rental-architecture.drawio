    <diagram id="pg9" name="9 - Auth Code Explained">
        <mxGraphModel dx="1540" dy="1428" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1050" background="#F7F9FD" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="pg9-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#0B3D91;strokeColor=#07265E;fontColor=#FFFFFF;fontSize=13;" value="&lt;b&gt;Auth code explained&lt;/b&gt; — what each file does, in the order it runs&lt;br&gt;features/auth · app/router/guards · services/api · Mock mode: VITE_USE_MOCK=true (no backend needed)" vertex="1">
                    <mxGeometry height="60" width="1520" x="40" y="20" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-2" parent="1" style="swimlane;startSize=32;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#0B3D91;strokeColor=#0B3D91;fontColor=#FFFFFF;fontStyle=1;fontSize=13;collapsible=0;swimlaneFillColor=#FFFFFF;strokeWidth=2;" value="① LOGIN — what happens when the user clicks “Sign in”" vertex="1">
                    <mxGeometry height="215" width="1520" x="40" y="100" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-3" parent="pg9-2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF3FC;strokeColor=#0B3D91;fontColor=#051A42;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;1 · LoginForm.jsx&lt;/b&gt;&lt;br&gt;Checks email format + password not empty. Errors show under each field. Nothing is sent if invalid." vertex="1">
                    <mxGeometry height="150" width="225" x="20" y="48" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-4" parent="pg9-2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF3FC;strokeColor=#0B3D91;fontColor=#051A42;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;2 · useAuth().login()&lt;/b&gt;&lt;br&gt;The hook only reads AuthContext. It calls &lt;i&gt;login(values)&lt;/i&gt; from the provider." vertex="1">
                    <mxGeometry height="150" width="225" x="270" y="48" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-5" parent="pg9-2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF4E5;strokeColor=#FF8C00;fontColor=#7A4300;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;3 · authService.login()&lt;/b&gt;&lt;br&gt;POST /auth/login via axiosClient. Backend answers &lt;i&gt;{ token, user }&lt;/i&gt;. Wrong password → error message." vertex="1">
                    <mxGeometry height="150" width="225" x="520" y="48" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-6" parent="pg9-2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF3FC;strokeColor=#0B3D91;fontColor=#051A42;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;4 · tokenStorage.save()&lt;/b&gt;&lt;br&gt;Saves JWT + user in localStorage (the only file that touches it)." vertex="1">
                    <mxGeometry height="150" width="225" x="770" y="48" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-7" parent="pg9-2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF3FC;strokeColor=#0B3D91;fontColor=#051A42;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;5 · AuthContext&lt;/b&gt;&lt;br&gt;&lt;i&gt;setUser(user)&lt;/i&gt; keeps user + role in memory. Exposes role, isAuthenticated, logout." vertex="1">
                    <mxGeometry height="150" width="225" x="1020" y="48" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-8" parent="pg9-2" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E8F6EC;strokeColor=#2E9E5B;fontColor=#124D2B;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;6 · navigate()&lt;/b&gt;&lt;br&gt;Back to the page the guard blocked (if this role may open it), else CUSTOMER → /customer · AGENCY → /agency · ADMIN → /admin" vertex="1">
                    <mxGeometry height="150" width="225" x="1270" y="48" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-9" edge="1" parent="1" source="pg9-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B3D91;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#0B3D91;" target="pg9-4" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-10" edge="1" parent="1" source="pg9-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B3D91;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#0B3D91;" target="pg9-5" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-11" edge="1" parent="1" source="pg9-5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B3D91;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#0B3D91;" target="pg9-6" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-12" edge="1" parent="1" source="pg9-6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B3D91;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#0B3D91;" target="pg9-7" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-13" edge="1" parent="1" source="pg9-7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B3D91;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#0B3D91;" target="pg9-8" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-14" parent="1" style="swimlane;startSize=32;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#0B3D91;strokeColor=#0B3D91;fontColor=#FFFFFF;fontStyle=1;fontSize=13;collapsible=0;swimlaneFillColor=#FFFFFF;strokeWidth=2;" value="② PAGE REFRESH — how the session is restored" vertex="1">
                    <mxGeometry height="215" width="760" x="40" y="340" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-15" parent="pg9-14" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF3FC;strokeColor=#0B3D91;fontColor=#051A42;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;AuthProvider starts&lt;/b&gt;&lt;br&gt;useState reads localStorage &lt;u&gt;before&lt;/u&gt; the first render." vertex="1">
                    <mxGeometry height="150" width="165" x="20" y="48" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-16" parent="pg9-14" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF3FC;strokeColor=#0B3D91;fontColor=#051A42;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;Token found?&lt;/b&gt;&lt;br&gt;Yes → user restored instantly, no flash of /login. No → user = null." vertex="1">
                    <mxGeometry height="150" width="165" x="203" y="48" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-17" parent="pg9-14" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF4E5;strokeColor=#FF8C00;fontColor=#7A4300;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;Real backend only&lt;/b&gt;&lt;br&gt;loading = true while GET /auth/me confirms the token." vertex="1">
                    <mxGeometry height="150" width="165" x="386" y="48" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-18" parent="pg9-14" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E8F6EC;strokeColor=#2E9E5B;fontColor=#124D2B;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;Guards decide&lt;/b&gt;&lt;br&gt;ProtectedRoute shows a spinner while loading, then lets the user in or sends to /login." vertex="1">
                    <mxGeometry height="150" width="165" x="569" y="48" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-19" edge="1" parent="1" source="pg9-15" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B3D91;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#0B3D91;" target="pg9-16" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-20" edge="1" parent="1" source="pg9-16" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B3D91;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#0B3D91;" target="pg9-17" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-21" edge="1" parent="1" source="pg9-17" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B3D91;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#0B3D91;" target="pg9-18" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-22" parent="1" style="swimlane;startSize=32;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#0B3D91;strokeColor=#0B3D91;fontColor=#FFFFFF;fontStyle=1;fontSize=13;collapsible=0;swimlaneFillColor=#FFFFFF;strokeWidth=2;" value="③ ROUTE GUARDS — checked from the outside in" vertex="1">
                    <mxGeometry height="215" width="740" x="820" y="340" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-23" parent="pg9-22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF4E5;strokeColor=#FF8C00;fontColor=#7A4300;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;ProtectedRoute&lt;/b&gt;&lt;br&gt;Logged in? No → /login (remembers the page in &lt;i&gt;state.from&lt;/i&gt;)." vertex="1">
                    <mxGeometry height="150" width="225" x="20" y="48" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-24" parent="pg9-22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FFF4E5;strokeColor=#FF8C00;fontColor=#7A4300;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;RoleRoute allowed=[…]&lt;/b&gt;&lt;br&gt;Role allowed? No → /403 ForbiddenPage. Always inside ProtectedRoute." vertex="1">
                    <mxGeometry height="150" width="225" x="265" y="48" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-25" parent="pg9-22" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDECEC;strokeColor=#D64545;fontColor=#6B1414;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;GuestOnlyRoute&lt;/b&gt;&lt;br&gt;Wraps /login, /register… A logged-in user is redirected to his dashboard." vertex="1">
                    <mxGeometry height="150" width="225" x="510" y="48" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-26" edge="1" parent="1" source="pg9-23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B3D91;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#0B3D91;" target="pg9-24" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-27" parent="1" style="swimlane;startSize=32;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#0B3D91;strokeColor=#0B3D91;fontColor=#FFFFFF;fontStyle=1;fontSize=13;collapsible=0;swimlaneFillColor=#FFFFFF;strokeWidth=2;" value="④ INTERCEPTORS — run on EVERY API call (interceptors.js)" vertex="1">
                    <mxGeometry height="215" width="760" x="40" y="580" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-28" parent="pg9-27" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF3FC;strokeColor=#0B3D91;fontColor=#051A42;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;Request&lt;/b&gt;&lt;br&gt;Reads the token and adds &lt;i&gt;Authorization: Bearer …&lt;/i&gt;" vertex="1">
                    <mxGeometry height="150" width="165" x="20" y="48" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-29" parent="pg9-27" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDECEC;strokeColor=#D64545;fontColor=#6B1414;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;401&lt;/b&gt;&lt;br&gt;Token expired: clear storage, fire &lt;i&gt;auth:logout&lt;/i&gt; (AuthContext → user = null), go to /login." vertex="1">
                    <mxGeometry height="150" width="165" x="203" y="48" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-30" parent="pg9-27" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDECEC;strokeColor=#D64545;fontColor=#6B1414;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;403&lt;/b&gt;&lt;br&gt;Go to /403 ForbiddenPage." vertex="1">
                    <mxGeometry height="150" width="165" x="386" y="48" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-31" parent="pg9-27" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDECEC;strokeColor=#D64545;fontColor=#6B1414;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;5xx / no network&lt;/b&gt;&lt;br&gt;Go to /500 ServerErrorPage." vertex="1">
                    <mxGeometry height="150" width="165" x="569" y="48" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-32" edge="1" parent="1" source="pg9-28" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#0B3D91;strokeWidth=2;endArrow=block;endFill=1;fontSize=11;labelBackgroundColor=#FFFFFF;fontColor=#0B3D91;" target="pg9-29" value="">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-33" parent="1" style="swimlane;startSize=32;html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#0B3D91;strokeColor=#0B3D91;fontColor=#FFFFFF;fontStyle=1;fontSize=13;collapsible=0;swimlaneFillColor=#FFFFFF;strokeWidth=2;" value="⑤ REGISTER &amp; PASSWORD RESET" vertex="1">
                    <mxGeometry height="215" width="740" x="820" y="580" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-34" parent="pg9-33" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EEF3FC;strokeColor=#0B3D91;fontColor=#051A42;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;RegisterForm type=…&lt;/b&gt;&lt;br&gt;One form for customer and agency (agency adds name + city). Checks password strength and confirmation, then POST /auth/register/…." vertex="1">
                    <mxGeometry height="150" width="225" x="20" y="48" as="geometry"/>
                </mxCell>
                <mxCell id="pg9-35" parent="pg9-33" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#E8F6EC;strokeColor=#2E9E5B;fontColor=#124D2B;fontSize=11;align=left;spacingLeft=8;spacingRight=6;verticalAlign=top;spacingTop=4;" value="&lt;b&gt;After register&lt;/b&gt;&lt;br&gt;Customer → /login “account created”. Agency → /login “wait for admin approval”. No auto-login." vertex="1">
